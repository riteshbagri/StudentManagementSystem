# ============================================================
# Student Management System — .gitignore
# ============================================================

# ─── Compiled & Build Output ─────────────────────────────────
*.class
target/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ─── Maven Wrapper (JAR is auto-downloaded; don't commit it) ─
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ─── Maven release / versioning artifacts ────────────────────
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── Sensitive Credentials — NEVER COMMIT ────────────────────
.env
*.env
.env.local
.env.*.local
secrets.properties
credentials.properties

# ─── IntelliJ IDEA ───────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/

# ─── Eclipse / Spring Tool Suite ─────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ─── VS Code ─────────────────────────────────────────────────
.vscode/

# ─── NetBeans ────────────────────────────────────────────────
nbproject/private/
nbbuild/
dist/
nbdist/

# ─── OS-generated files ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Spring Boot generated ───────────────────────────────────
HELP.md

# ─── Node / npm (if any tooling is added later) ──────────────
node_modules/

# ─── NOTE: screenshots/ folder IS tracked intentionally ──────
# Do NOT add screenshots/ here — Postman screenshots are
# required evidence for the college submission.
